NODE_ENV=development
PORT=3333
DATABASE_URL=postgres://album:album@localhost:5433/album
JWT_SECRET=troque-por-um-segredo-com-mais-de-32-caracteres
JWT_EXPIRES_IN_SECONDS=28800
# Se 1, seed apaga figurinhas/páginas da edição e recarrega do JSON
FORCE_SEED=0

# JPG locais (opcional). Só use STICKER_IMAGE_URL_TEMPLATE se os arquivos existirem em
# backend/public/stickers/<slug>/<album_label>.jpg — senão deixe comentado e use thumbs LastSticker (proxy).
# STICKER_IMAGE_URL_TEMPLATE=http://localhost:3333/static/stickers/{editionSlug}/{albumLabel}.jpg

# Thumbs LastSticker na UI passam por proxy (default em código = images.weserv.nl). Valor vazio desativa.
# STICKER_IMAGE_PROXY_TEMPLATE=https://images.weserv.nl/?url={url}&w=420&output=jpg

# Base das URLs gravadas no banco pelo job: npm run job:cache-sticker-images -- --edition <slug>
# STICKER_PUBLIC_BASE_URL=http://127.0.0.1:3333
